    {
      "name": "Clients",
      "item": [
        {
          "name": "Create client with services",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"10814\",\n  \"client_short_name\": \"มหาวิทยาลัยบูรพา\",\n  \"services\": [\n    {\n      \"service_id\": \"00\",\n      \"serv_name\": \"ค่าลงทะเบียน/รักษาสภาพ\"\n    },\n    {\n      \"service_id\": \"02\",\n      \"serv_name\": \"ค่าขึ้นทะเบียนปริญญา\"\n    },\n    {\n      \"service_id\": \"03\",\n      \"serv_name\": \"ค่าสมัครเข้าศึกษา ป.ตรี\"\n    },\n    {\n      \"service_id\": \"05\",\n      \"serv_name\": \"ค่ารายงานตัวนิสิต\"\n    },\n    {\n      \"service_id\": \"07\",\n      \"serv_name\": \"จองเครื่องหมายนิสิต\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/clients"
          },
          "response": []
        },
        {
          "name": "List clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients?limit=50&offset=0"
          },
          "response": []
